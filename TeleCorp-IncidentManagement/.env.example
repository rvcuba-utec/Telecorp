# =====================================================================
#  PulsoRed (módulo Azure) - variables globales
#  Copia este archivo a ".env" (que NO se versiona) y completa los valores.
#  - En local: el backend lee ".env" al arrancar (las variables del sistema tienen prioridad).
#  - En Azure: .\infra\deploy.ps1 sube estos valores como app settings (las claves van a Key Vault).
#  - Cambiar solo las URLs/claves después:  .\infra\deploy.ps1 -SettingsOnly
#  Si una URL base queda vacía, esa integración funciona en modo simulado (mock / reglas / caché).
# =====================================================================

# ---------------------------------------------------------------------
#  AWS  (repo TeleCorp-InfraMonitoring, API Gateway + Lambda)
#  Lo da P1 cuando haga "sam deploy". Ejemplo:
#  AWS_API_BASE=https://abc123xyz.execute-api.us-east-1.amazonaws.com
# ---------------------------------------------------------------------
AWS_API_BASE=https://0w6e50qek3.execute-api.us-east-1.amazonaws.com
# Clave "azure" del secreto pulsored/secrets.inbound (header X-API-Key)
AWS_API_KEY=
AWS_CONFIG_PATH=/config
AWS_ANTENNAS_PATH=/antennas
AWS_PREDICTIONS_PATH=/predictions
AWS_TIMEOUT_S=5

# Clave con la que AWS llama a Azure (POST {AZURE}/api/events/infra, header X-API-Key).
# La genera deploy.ps1 si queda vacía; se entrega a P1 para su secreto outbound.azure_api_key.
AZURE_INBOUND_API_KEY=

# ---------------------------------------------------------------------
#  GCP  (repo TeleCorp-DataAnalytics, API Gateway -> Cloud Run)
#  URL base del API Gateway de P3 (incluye /v1). Rutas: /ingest/incidents, /ai/classify-report, /ai/summarize-incident
# ---------------------------------------------------------------------
GCP_API_BASE=https://telecorp-gateway-1gcgm860.uc.gateway.dev/v1
# API key de Google Cloud que P3 crea para Azure (header x-api-key). Sin ella el Gateway responde 401.
GCP_API_KEY=
GCP_INGEST_PATH=/ingest/incidents
GCP_CLASSIFY_PATH=/ai/classify-report
GCP_SUMMARIZE_PATH=/ai/summarize-incident
GCP_TIMEOUT_S=10
AI_CLASSIFY_TIMEOUT_S=4
AI_SUMMARIZE_TIMEOUT_S=8

# ---------------------------------------------------------------------
#  Reglas de negocio (valores por defecto; si AWS GET /config trae la misma clave, manda AWS)
# ---------------------------------------------------------------------
USERS_THRESHOLD=10
WINDOW_HOURS=24
# ZONA = cualquier categoría cuenta (decisión del equipo) | ZONA_Y_CATEGORIA
CORRELATION_MODE=ZONA
EVIDENCE_WINDOW_HOURS=48
RATE_LIMIT_PER_HOUR=5
OPERATOR_WAIT_MIN=120
RECOVERY_POLL_MIN=5
RECOVERY_QUIET_MIN=15
COOLDOWN_MIN=30
CONFIG_CACHE_S=300

# ---------------------------------------------------------------------
#  Azure (las completa deploy.ps1 en la nube; en local vacías = todo en memoria)
# ---------------------------------------------------------------------
COSMOS=
COSMOS_DB=pulsored
SB=
OPERATOR_TOKEN=dev-operator-token
ACS_CONNECTION_STRING=
ACS_SENDER=
