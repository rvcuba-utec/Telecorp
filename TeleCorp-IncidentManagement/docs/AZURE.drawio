<mxfile host="app.diagrams.net">
  <diagram id="azure-pulsored" name="PulsoRed - Azure">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ===== TITULOS DE COLUMNA ===== -->
        <mxCell id="t_in" value="ENTRADAS" style="text;html=1;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="200" height="30" as="geometry"/></mxCell>
        <mxCell id="t_out" value="SALIDAS" style="text;html=1;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1390" y="10" width="200" height="30" as="geometry"/></mxCell>

        <!-- ===== CONTENEDOR AZURE ===== -->
        <mxCell id="az" value="Microsoft Azure  -  Resource Group rg-pulsored (region westus2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f7fd;strokeColor=#0078d4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#0078d4;" vertex="1" parent="1"><mxGeometry x="250" y="20" width="1100" height="980" as="geometry"/></mxCell>

        <!-- ===== ENTRADAS ===== -->
        <mxCell id="usr" value="&lt;b&gt;Usuario&lt;/b&gt;&lt;br&gt;Portal publico: crear reporte y consultar estado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="op" value="&lt;b&gt;Operador&lt;/b&gt;&lt;br&gt;Consola: bandeja, acciones, mapa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="aws" value="&lt;b&gt;AWS - Modulo infraestructura&lt;/b&gt;&lt;br&gt;Lambda + Step Functions + SQS (outbox con reintentos)&lt;br&gt;Eventos de antenas: caida, saturacion, recuperacion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="200" height="110" as="geometry"/></mxCell>

        <!-- ===== FRONTEND ===== -->
        <mxCell id="swa" value="&lt;b&gt;Azure Static Web Apps (Free)&lt;/b&gt;&lt;br&gt;Portal usuario + Consola operador (React/Vite)&lt;br&gt;&lt;i&gt;equiv. AWS: Amplify Hosting&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#0078d4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="60" width="300" height="70" as="geometry"/></mxCell>

        <!-- ===== FUNCTION APP ===== -->
        <mxCell id="fbg" value="Azure Functions - Function App pulsored-func (Python, Consumption/Flex)  |  equiv. AWS: Lambda + API Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="170" width="640" height="470" as="geometry"/></mxCell>

        <mxCell id="f1" value="&lt;b&gt;intake-report&lt;/b&gt;&lt;br&gt;HTTP POST /reports&lt;br&gt;idempotente, responde 202" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="310" y="215" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="f2" value="&lt;b&gt;reports-api&lt;/b&gt;&lt;br&gt;HTTP GET /reports/{id}&lt;br&gt;PATCH estado + historial" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="520" y="215" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="f3" value="&lt;b&gt;incidents-api&lt;/b&gt;&lt;br&gt;HTTP GET/PATCH /incidents&lt;br&gt;confirmar / descartar / estado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="730" y="215" width="190" height="60" as="geometry"/></mxCell>

        <mxCell id="f4" value="&lt;b&gt;ingest-infra-event&lt;/b&gt;&lt;br&gt;HTTP POST /infra/events&lt;br&gt;function key, dedupe por event_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="310" y="295" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="f5" value="&lt;b&gt;infra-linker&lt;/b&gt;&lt;br&gt;Cosmos change feed (infra_events)&lt;br&gt;relaciona antena/zona con incidentes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="520" y="295" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="f6" value="&lt;b&gt;correlator&lt;/b&gt;&lt;br&gt;Cosmos change feed (reports)&lt;br&gt;10 usuarios / zona / tipo / 24 h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="730" y="295" width="190" height="60" as="geometry"/></mxCell>

        <mxCell id="f7" value="&lt;b&gt;incident-lifecycle&lt;/b&gt; - Durable Functions (orquestador)&lt;br&gt;Parallel (infra + IA) - prioridad - esperar operador (external event + timer 2 h) - ciclo de recuperacion (timers) - cierre - export&lt;br&gt;&lt;i&gt;equiv. AWS: Step Functions&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe599;strokeColor=#bf9000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="310" y="375" width="400" height="70" as="geometry"/></mxCell>
        <mxCell id="f8" value="&lt;b&gt;Actividades&lt;/b&gt;&lt;br&gt;load_context, check_infra, ai_enrich (fallback reglas), compute_priority, set_status, enqueue_notifications, enqueue_export" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="730" y="375" width="190" height="70" as="geometry"/></mxCell>

        <mxCell id="f9" value="&lt;b&gt;notifier&lt;/b&gt;&lt;br&gt;Service Bus trigger&lt;br&gt;1 mensaje por usuario y etapa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="310" y="465" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="f10" value="&lt;b&gt;exporter&lt;/b&gt;&lt;br&gt;Service Bus trigger&lt;br&gt;agregados sin PII a GCP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="520" y="465" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="f11" value="&lt;b&gt;redrive-dlq&lt;/b&gt;&lt;br&gt;HTTP (operador)&lt;br&gt;reenvia mensajes de la DLQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="730" y="465" width="190" height="60" as="geometry"/></mxCell>

        <mxCell id="fnote" value="Identidad administrada de la Function App accede a Key Vault y Cosmos sin llaves en codigo. Extra: lectura de config (umbrales) desde app settings." style="text;html=1;whiteSpace=wrap;fontSize=9;fontStyle=2;align=left;" vertex="1" parent="1"><mxGeometry x="310" y="560" width="610" height="40" as="geometry"/></mxCell>

        <!-- ===== COSMOS ===== -->
        <mxCell id="cos" value="&lt;b&gt;Azure Cosmos DB (NoSQL)&lt;/b&gt;&lt;br&gt;&lt;i&gt;equiv. AWS: DynamoDB (+ change feed = Streams)&lt;/i&gt;&lt;br&gt;&lt;br&gt;DB pulsored - free tier / serverless&lt;br&gt;reports (pk /zone_id)&lt;br&gt;incidents (pk /zone_id)&lt;br&gt;incident_users (pk /incident_id)&lt;br&gt;history (pk /entity_id)&lt;br&gt;infra_events (pk /zone_id, TTL)&lt;br&gt;notifications (idempotencia)&lt;br&gt;zones (catalogo) - leases (change feed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="980" y="170" width="340" height="250" as="geometry"/></mxCell>

        <!-- ===== SERVICE BUS ===== -->
        <mxCell id="sb" value="&lt;b&gt;Azure Service Bus (Basic/Standard)&lt;/b&gt;&lt;br&gt;&lt;i&gt;equiv. AWS: SQS + DLQ&lt;/i&gt;&lt;br&gt;&lt;br&gt;queue notifications&lt;br&gt;queue analytics-export&lt;br&gt;Dead-letter queue en cada una (MaxDeliveryCount 10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="980" y="450" width="340" height="150" as="geometry"/></mxCell>

        <!-- ===== ACS ===== -->
        <mxCell id="acs" value="&lt;b&gt;Azure Communication Services&lt;/b&gt;&lt;br&gt;Email (real) + SMS (opcional)&lt;br&gt;&lt;i&gt;equiv. AWS: SES / SNS&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#0078d4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="980" y="680" width="340" height="80" as="geometry"/></mxCell>

        <!-- ===== FILA INFERIOR ===== -->
        <mxCell id="kv" value="&lt;b&gt;Key Vault&lt;/b&gt;&lt;br&gt;API keys, token operador, llave GCP&lt;br&gt;&lt;i&gt;equiv. Secrets Manager&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="290" y="690" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="ai" value="&lt;b&gt;Application Insights + Log Analytics&lt;/b&gt;&lt;br&gt;trazas, alertas, dashboard&lt;br&gt;&lt;i&gt;equiv. CloudWatch / X-Ray&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="690" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="sto" value="&lt;b&gt;Storage Account&lt;/b&gt;&lt;br&gt;estado de Durable Functions&lt;br&gt;&lt;i&gt;requerido por Functions&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="720" y="690" width="170" height="70" as="geometry"/></mxCell>

        <!-- ===== SALIDAS ===== -->
        <mxCell id="usr_out" value="&lt;b&gt;Usuario afectado&lt;/b&gt;&lt;br&gt;Email / SMS en 3 etapas: evaluando, identificada, restablecido" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1390" y="675" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="gcp" value="&lt;b&gt;GCP - analytics-sink&lt;/b&gt;&lt;br&gt;Cloud Run - BigQuery - Looker&lt;br&gt;HTTPS, solo datos agregados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1390" y="790" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="awsack" value="&lt;b&gt;AWS (respuesta)&lt;/b&gt;&lt;br&gt;202 aceptado / 200 duplicado / 5xx reintentar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1390" y="290" width="200" height="80" as="geometry"/></mxCell>

        <!-- ===== FLUJOS ===== -->
        <mxCell id="e1" value="1 HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="usr" target="swa"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="1 HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="op" target="swa"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="2 REST + CORS (consola: x-operator-token)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="swa" target="fbg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="3 POST /infra/events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="aws" target="f4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="4 lee / escribe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;startArrow=block;fontSize=10;strokeColor=#82b366;" edge="1" parent="1" source="fbg" target="cos"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="5 encola / consume" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;startArrow=block;fontSize=10;strokeColor=#9673a6;" edge="1" parent="1" source="fbg" target="sb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="6 envia" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="fbg" target="acs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="7 Email / SMS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="acs" target="usr_out"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="8 HTTPS agregados + Idempotency-Key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;exitX=0.97;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="fbg" target="gcp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="911" y="830"/></Array></mxGeometry></mxCell>
        <mxCell id="e10" value="9 respuesta al evento" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="f4" target="awsack"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="325"/><mxPoint x="940" y="150"/><mxPoint x="1360" y="150"/><mxPoint x="1360" y="330"/></Array></mxGeometry></mxCell>

        <mxCell id="d1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;fontSize=9;" edge="1" parent="1" source="kv" target="fbg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;fontSize=9;" edge="1" parent="1" source="ai" target="fbg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;fontSize=9;" edge="1" parent="1" source="sto" target="fbg"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ===== LEYENDA ===== -->
        <mxCell id="legend" value="&lt;b&gt;Flujos&lt;/b&gt;&lt;br&gt;1) Usuario u operador abre el portal en Static Web Apps.&lt;br&gt;2) El navegador llama a la Function App (HTTP triggers). POST /reports guarda en Cosmos y responde 202 con report_id.&lt;br&gt;3) AWS envia eventos de antena a POST /infra/events (function key). Se guardan en Cosmos con id=event_id: si ya existe, responde 200 duplicado (AWS puede reenviar sin duplicar).&lt;br&gt;4) Change feed de Cosmos dispara: correlator (reportes -&gt; incidente colectivo, abre Durable Functions) e infra-linker (evento de antena -&gt; incidentes y reportes de la zona).&lt;br&gt;5) incident-lifecycle (Durable Functions) calcula prioridad, espera al operador, vigila recuperacion y cierra; encola notificaciones y export en Service Bus.&lt;br&gt;6-7) notifier envia email/SMS via Azure Communication Services, 1 mensaje por usuario y etapa.&lt;br&gt;8) exporter envia datos agregados (sin PII) al analytics-sink de GCP; si falla, Service Bus reintenta y deja en DLQ para reenvio.&lt;br&gt;Transversal: Key Vault (secretos), Application Insights (observabilidad), Storage (estado de Durable Functions)." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="1030" width="1570" height="200" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
