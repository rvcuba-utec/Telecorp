{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "telemetry-batch.schema.json",
  "title": "payload de type=telemetry.batch (antenas -> AWS, y AWS -> GCP)",
  "type": "object",
  "required": ["samples"],
  "additionalProperties": false,
  "properties": {
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["antenna_id", "ts", "gb_per_min"],
        "additionalProperties": false,
        "properties": {
          "antenna_id": { "type": "string", "pattern": "^ANT-LIM-\\d{3}$" },
          "zone_id": { "type": "string", "description": "Opcional al recibir (AWS lo resuelve por catalogo); siempre presente al reenviar a GCP" },
          "ts": { "type": "string", "format": "date-time" },
          "gb_per_min": { "type": "number", "minimum": 0 },
          "state": { "enum": ["NORMAL", "CAIDA", "INHABILITADA", "SATURADA"], "description": "Lo calcula AWS; se incluye al reenviar a GCP" }
        }
      }
    }
  }
}
