# Copiar a config.env (fuera de Git).
STACK_NAME=pulsored-aws
REGION=us-east-1
# Correo de operadores para las alarmas (SNS). AWS envía un correo de confirmación. Vacío = sin suscripción.
OPS_EMAIL=
# true = despliega un receptor simulado de Azure y GCP para probar sin las otras nubes.
DEPLOY_MOCK=true
